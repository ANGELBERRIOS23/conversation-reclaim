{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversation Reclaim",
  "version": "3.0.1",
  "identifier": "com.aberrios.conversation-reclaim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conversation Reclaim",
        "width": 1120,
        "height": 780,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Safely reclaim AI conversation storage",
    "longDescription": "A native desktop utility that finds and safely removes regenerable or compacted AI assistant data.",
    "copyright": "Copyright © 2026 Angel Berrios"
  }
}
